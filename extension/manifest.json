{
  "manifest_version": 3,
  "name": "Veebiabiline",
  "version": "0.2.0",
  "description": "Sõbralik abiline, kes selgitab veebilehti ja näitab, kuhu vajutada.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ava Veebiabiline",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "permissions": ["sidePanel", "storage", "scripting"],
  "host_permissions": ["<all_urls>"]
}
